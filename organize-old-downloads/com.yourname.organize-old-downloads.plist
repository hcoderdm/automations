<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yourname.organize-old-downloads</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__DIR__/organize_old_downloads.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/OrganizeOldDownloads.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/OrganizeOldDownloads.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
</dict>
</plist>
