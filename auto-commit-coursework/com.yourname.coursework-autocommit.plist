<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yourname.coursework-autocommit</string>
  <!-- Run through bash (not exec) so the Full Disk Access granted to /bin/bash covers
       python and git reading ~/Documents. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>/usr/bin/python3 /Users/USERNAME/Automations/auto-commit-coursework/auto_commit_coursework.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/coursework-autocommit.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/coursework-autocommit.log</string>
</dict>
</plist>
